
import java.io.*;
import java.util.Scanner;

public class Q10 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        try {
            FileWriter fw = new FileWriter("employees.txt");

            System.out.print("Enter Employee ID: ");
            String id = sc.nextLine();

            System.out.print("Enter Employee Name: ");
            String name = sc.nextLine();

            System.out.print("Enter Department: ");
            String dept = sc.nextLine();

            System.out.print("Enter Salary: ");
            String salary = sc.nextLine();

            fw.write(id + "," + name + "," + dept + "," + salary);
            fw.close();

            System.out.println("Employee record saved successfully.");

            System.out.print("\nEnter Employee ID to search: ");
            String searchId = sc.nextLine();

            BufferedReader br = new BufferedReader(
                new FileReader("employees.txt"));

            String line;
            boolean found = false;

            while ((line = br.readLine()) != null) {
                String[] data = line.split(",", -1);

                if (data.length == 4 &&
                    data[0].equals(searchId)) {

                    System.out.println("\nEmployee Record Found!");
                    System.out.println("Employee ID: " + data[0]);
                    System.out.println("Employee Name: " + data[1]);
                    System.out.println("Department: " + data[2]);
                    System.out.println("Salary: " + data[3]);

                    found = true;
                    break;
                }
            }

            br.close();

            if (!found) {
                System.out.println("Employee record not found.");
            }
        }
        catch (FileNotFoundException e) {
            System.out.println("Employee file does not exist.");
        }
        catch (IOException e) {
            System.out.println("Error: " + e.getMessage());
        }

        sc.close();
    }
}
